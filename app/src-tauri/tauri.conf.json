{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaraAlwaysOK",
  "version": "0.1.0",
  "identifier": "world.aako.kara-always-oki",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "KaraAlwaysOK",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "files": {
        "Resources/ja.lproj/InfoPlist.strings": "./macos/ja.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "./macos/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "./macos/zh-Hant.lproj/InfoPlist.strings"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/GITHUB-OWNER/kara-always-oki/releases/latest/download/latest.json"],
      "pubkey": "REPLACE-WITH-UPDATER-PUBLIC-KEY"
    }
  }
}
